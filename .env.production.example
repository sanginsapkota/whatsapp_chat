# Production reference for smm.bitflux.com.np — not read by Laravel directly.
# Copy the values you need into the server's real .env; never commit the real one.

APP_NAME="Shuvakamana Butcher"
APP_ENV=production
APP_KEY=                        # php artisan key:generate --show (generate fresh per environment)
APP_DEBUG=false
APP_URL=https://smm.bitflux.com.np

# "*" trusts whatever reverse proxy fronts the app (nginx/Cloudflare). Narrow this to
# the proxy's IP/CIDR only if the app server is also reachable directly from the internet.
TRUSTED_PROXIES=*
# Not required when APP_ENV=production (AppServiceProvider forces https:// already),
# kept here for clarity / in case the app ever runs with APP_ENV=local behind this domain.
FORCE_HTTPS=true

LOG_CHANNEL=stack
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=subhakamana
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true      # cookies only ever sent over https
SESSION_DOMAIN=smm.bitflux.com.np

QUEUE_CONNECTION=database       # run `php artisan queue:work` under a process supervisor (systemd/Supervisor)
CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="orders@bitflux.com.np"
MAIL_FROM_NAME="${APP_NAME}"

# WhatsApp Cloud API — see Meta App Dashboard → WhatsApp → API Setup / Business Settings.
# Webhook callback URL to register with Meta: https://smm.bitflux.com.np/webhooks/whatsapp
WHATSAPP_API_VERSION=v21.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=          # permanent token from a System User, not the 24h quick-start token
WHATSAPP_VERIFY_TOKEN=          # any random string; must match what you enter in Meta's webhook config
WHATSAPP_APP_SECRET=            # App → Settings → Basic → App secret (enables webhook signature checks)
